{
  "name": "@monos/ui",
  "version": "0.3.0",
  "description": "The Monos interface kit: warm paper, one radius, quiet controls, and themes that read in light and dark.",
  "type": "module",
  "license": "MIT",
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./themes.css": "./src/styles/themes.css",
    "./tailwind-preset": "./src/tailwind-preset.js",
    "./themes": "./src/themes.js"
  },
  "files": [
    "src",
    "docs",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:gallery": "vite build",
    "preview": "vite preview",
    "build:themes": "node scripts/build-themes.js",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./jsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^4.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "@testing-library/svelte": "^5.2.8",
    "autoprefixer": "^10.4.16",
    "jsdom": "^24.1.1",
    "lucide-svelte": "^0.302.0",
    "postcss": "^8.4.32",
    "svelte": "^4.2.7",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.8"
  },
  "author": "aa-blinov",
  "keywords": [
    "svelte",
    "svelte-kit",
    "ui",
    "design-system",
    "tailwindcss",
    "components",
    "monos"
  ],
  "homepage": "https://aa-blinov.github.io/monos-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa-blinov/monos-ui.git"
  },
  "bugs": {
    "url": "https://github.com/aa-blinov/monos-ui/issues"
  }
}
